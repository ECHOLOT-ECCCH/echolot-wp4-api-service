WIKIFIER_API_KEY=your_api_key_here
API_KEY=replace_with_a_long_random_value
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

# Reconciliation algorithm llm_based through HiTZ's hosted service: a key from
# https://zerbitzuak.hitz.eus/tresnak (Profile -> Generate new API Key). When set, the
# OPENAI_* settings below are not used.
HITZ_API_KEY=
# HITZ_API_URL=https://zerbitzuak.hitz.eus/api

# Reconciliation algorithm llm_based without HITZ_API_KEY: an OpenAI-compatible chat endpoint (e.g. Latxa
# served by vLLM). Separate from the Anthropic settings above, which only /enrich uses.
# All seven are required. Keep OPENAI_STREAM=False.
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=Latxa
OPENAI_MAX_TOKENS=10
OPENAI_TEMPERATURE=0.0
OPENAI_TOP_P=0.95
OPENAI_STREAM=False

# Reconciliation algorithm rule_based: a TSV datasheet of people (Wikidata or ULAN dump).
RULE_BASED_TARGET_FILE=draft/rule_based/datasheets/ulan.tsv
